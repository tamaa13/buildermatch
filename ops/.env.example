# Backend webhook source
BACKEND_URL=http://localhost:3001
POLL_INTERVAL_MS=15000

# Chain explorer
# Base Sepolia is the public PoC chain for the hackathon. Architecture is
# chain-agnostic — swap EXPLORER_URL + CHAIN_ID + the backend's RPC / chain
# config to retarget BNB Chapel (97) or mainnet in one env swap, zero code.
# EXPLORER_URL is the canonical name; BSCSCAN_EXPLORER kept as a fallback.
EXPLORER_URL=https://sepolia.basescan.org
CHAIN_ID=84532
EXPLORER_LABEL=BaseScan

# Reference — live VerdictRegistry on Base Sepolia (set in backend .env, not here):
# CONTRACT_ADDRESS=0x4f635A02B6Cf998A0508dADE3e2f85e5a2dCAB7a
# Deploy tx: 0x4dd110c3d520fa7a2a428fa5af8f7823158426a6091b1287d8cc645f8ca3d320

# Twitter (Free tier — 50 posts/24h)
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pinata
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# Frontend (for verdict permalink in posts)
FRONTEND_URL=

# Toggles
DRY_RUN=true
