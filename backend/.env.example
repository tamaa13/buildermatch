# Copy to .env and fill in. All *_KEY / *_JWT / *_PRIVATE_KEY values below are
# placeholders — never commit real credentials. The mock toggles at the bottom
# let you run end-to-end without any of these keys.
#
# Quickstart (local, no external calls):
#   MOCK_CHAIN=true MOCK_IPFS=true MOCK_SENTIMENT=true MOCK_AGENTS=true bun run dev
#
# Quickstart (real Claude + local anvil chain):
#   1) run anvil + deploy VerdictRegistry (see contracts/)
#   2) paste ANTHROPIC_API_KEY, CONTRACT_ADDRESS, ORCHESTRATOR_PRIVATE_KEY below
#   3) MOCK_CHAIN=false MOCK_AGENTS=false bun run dev

# Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# BscScan — base URL flips between testnet and mainnet. Leave key blank for
# unauthenticated rate limits, or paste your key for higher throughput.
BSCSCAN_API_KEY=
BSCSCAN_TESTNET_BASE=https://api-testnet.bscscan.com/api

# Four.meme
FOURMEME_API_BASE=https://four.meme/meme-api/v1

# IPFS / Pinata (required only when MOCK_IPFS=false)
PINATA_JWT=

# Chain — set per deployment. Supported chainIds:
#   31337 (anvil)        RPC=http://127.0.0.1:8545
#   97    (bsc-testnet)  RPC=https://data-seed-prebsc-1-s1.binance.org:8545
#   84532 (base-sepolia) RPC=https://sepolia.base.org
# Add more by extending chainFor() in src/chain.ts.
#
# ORCHESTRATOR_PRIVATE_KEY must be the address that the registry recognizes as
# orchestrator() (see recordVerdict access control). Local anvil accepts the
# well-known deterministic account #0; production must be a dedicated key.
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
ORCHESTRATOR_PRIVATE_KEY=

# Server
PORT=3001
LOG_LEVEL=info

# Mock toggles. Flip to true to skip the external call and use deterministic
# stubs — useful for frontend dev, CI, and demo-mode submissions that don't
# require on-chain deploy.
MOCK_CHAIN=true
MOCK_IPFS=false
MOCK_SENTIMENT=true
MOCK_AGENTS=false
