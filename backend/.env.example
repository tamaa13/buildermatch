# Copy to .env and fill in. All *_KEY / *_JWT / *_PRIVATE_KEY values below are
# placeholders — never commit real credentials. The mock toggles at the bottom
# let you run end-to-end without any of these keys.
#
# Quickstart (local, no external calls):
#   MOCK_CHAIN=true MOCK_IPFS=true MOCK_AGENTS=true bun run dev
#
# Quickstart (real Claude + Base Sepolia):
#   1) paste ANTHROPIC_API_KEY + CONTRACT_ADDRESS + ORCHESTRATOR_PRIVATE_KEY below
#   2) MOCK_CHAIN=false MOCK_AGENTS=false bun run dev

# Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# GitHub (optional — lifts unauthenticated rate limit from 60 to 5000/hr)
GITHUB_TOKEN=

# Snapshot GraphQL (public endpoint; override only for self-hosted mirror)
SNAPSHOT_GRAPHQL=https://hub.snapshot.org/graphql

# Explorer API (used by profile-build for wallet tx history). Can target any
# Etherscan-compatible explorer — BSC testnet shown as default. Leave key
# blank for anonymous rate limits.
BSCSCAN_API_KEY=
BSCSCAN_TESTNET_BASE=https://api-testnet.bscscan.com/api

# IPFS / Pinata (required only when MOCK_IPFS=false)
PINATA_JWT=

# Chain — set per deployment. Supported chainIds:
#   31337 (anvil)        RPC=http://127.0.0.1:8545
#   97    (bsc-testnet)  RPC=https://data-seed-prebsc-1-s1.binance.org:8545
#   84532 (base-sepolia) RPC=https://sepolia.base.org
# Add more by extending chainFor() in src/chain.ts.
#
# ORCHESTRATOR_PRIVATE_KEY signs recordVerdict / recordAttestation — must
# match the orchestrator() role on the deployed registry. For demo day we use
# the deployer key; prod separates them.
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
CONTRACT_ADDRESS=
ORCHESTRATOR_PRIVATE_KEY=

# Server
PORT=3001
LOG_LEVEL=info

# Mock toggles. Flip to true to skip external calls and run with deterministic
# stubs — useful for frontend dev, CI, and a judge-facing demo that doesn't
# need live Claude / on-chain writes.
MOCK_CHAIN=false
MOCK_IPFS=true
MOCK_AGENTS=true

# DEMO_MODE: relax per-wallet rate limit (1/sec instead of 1/hour) so a demo
# operator can rebuild a profile repeatedly on camera. Per-IP limit stays
# strict regardless. Recording / judge-facing only — NEVER set in prod.
DEMO_MODE=false
